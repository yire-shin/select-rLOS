\name{msrlos-package}
\alias{msrlos-package}
\docType{package}
\title{msrlos: Model Selection for r-Largest Order Statistics}
\description{
Model-selection procedures for r-largest order-statistic data. The main function \code{ms.rlos()} evaluates Survival, r-Median, Alter Surv, and Alter r-Med procedures using entropy-difference selection of \eqn{r} and AIC comparisons at a common order.
}
\author{
Shin Yire, Jihong Park, and Jeong-Soo Park. Correspondence: \email{jspark@jnu.ac.kr}.
}
